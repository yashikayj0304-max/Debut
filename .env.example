# ===== Copy to .env (never commit it) =====
APP_ENV=development            # set to "production" when deployed
SECRET_KEY=                    # REQUIRED in production: python -c "import secrets;print(secrets.token_hex(32))"
APP_NAME=Debut
COMPANY_NAME=Your Company Pvt Ltd
SUPPORT_EMAIL=support@yourdomain.com
APP_URL=http://127.0.0.1:8001  # public https URL in production (used in emails and links)
TRIAL_DAYS=14
ADMIN_EMAILS=you@yourdomain.com   # comma-separated; these users see /admin

# Database (blank = local SQLite file). Production: PostgreSQL
DATABASE_URL=
DB_PASSWORD=                   # only for docker-compose

# AI (metered per plan; you pay Anthropic)
ANTHROPIC_API_KEY=
GTM_MODEL=claude-sonnet-5

# Email (SMTP). Without it, verification/reset/invite links are only logged (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Debut <no-reply@yourdomain.com>

# Billing: Razorpay Subscriptions (blank keys + development = demo mode with instant plan switching)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_TEAM=
RAZORPAY_PLAN_AGENCY=

# Optional
S3_BUCKET=                     # mood-board images; else stored on disk (UPLOAD_DIR)
S3_REGION=ap-south-1
S3_ENDPOINT=                   # for Cloudflare R2 / other S3-compatible services
REDIS_URL=                     # shared rate-limit counters when running several workers/instances
SENTRY_DSN=
WEB_CONCURRENCY=3
PRICE_NOTE=+ GST               # or "incl. GST"; the amount of your Razorpay plans must match

# Security: require two-factor login for platform-admin (/admin) access. Default: on in production, off in development.
# The owner turns on 2FA under Account, then /admin unlocks. Lost phone? python manage.py reset-2fa you@yourdomain.com
REQUIRE_ADMIN_2FA=

# ===== Business identity: shown on Contact, Refund and Privacy pages (payment gateways ask for these) =====
SUPPORT_PHONE=                 # e.g. +91 98xxxxxx00
SUPPORT_HOURS=Monday to Friday, 10:00 to 18:00 IST
COMPANY_ADDRESS=               # registered / business address
COMPANY_GSTIN=                 # optional, shown in the footer
GRIEVANCE_OFFICER=             # name of the person who handles privacy requests and complaints
GRIEVANCE_EMAIL=               # defaults to SUPPORT_EMAIL
REFUND_WINDOW_DAYS=7           # days after the first payment in which you refund on request (match your written policy)
GA_MEASUREMENT_ID=             # optional Google Analytics 4 id; loaded on public marketing pages only, never inside the app

# ===== Launch guard-rails =====
AI_DAILY_CAP=0                 # platform-wide AI credits per day across ALL customers (0 = off). Set e.g. 300 during launch week to cap your API bill.
MAINTENANCE=0                  # 1 = everyone except the platform admin sees a "being updated" page (use during risky deploys)

# ===== Live market data (Market Pulse) and AI live research: all optional =====
NEWS_PROVIDER=google_rss       # google_rss (free, fine for the pilot) | gnews | newsdata. Use a licensed API (gnews or newsdata) once you scale or charge customers.
GNEWS_API_KEY=                 # https://gnews.io  (if NEWS_PROVIDER=gnews)
NEWSDATA_API_KEY=              # https://newsdata.io (if NEWS_PROVIDER=newsdata)
YOUTUBE_API_KEY=               # Google Cloud: enable "YouTube Data API v3". Adds trending videos per keyword.
PULSE_HN=1                     # Hacker News search (only used for tech-related industries)
PULSE_TRENDS=1                 # Google's daily trending-searches feed (India and global)
PULSE_REDDIT=0                 # Reddit public feeds for Subreddit watch items (often blocked from cloud servers; check Reddit's terms)
PULSE_CACHE_MINUTES=60         # data older than this is treated as stale
PULSE_MIN_REFRESH_MINUTES=10   # users cannot refresh more often than this
AI_WEB_SEARCH=1                # AI Studio "live web research" (enable web search in your Anthropic console first)
AI_RESEARCH_EXTRA=2            # extra credits a research answer costs (web searches cost you more)
